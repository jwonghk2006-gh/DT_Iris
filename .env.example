# Copy this file to .env (same folder) and fill in. Never commit or share .env.
#
# Longbridge: open.longbridge.com -> Developer -> your app.
# The App Key and App Secret are the SAME for the demo and the live account.
# Only the Access Token changes when you switch account, so copy both tokens.
LONGPORT_APP_KEY=
LONGPORT_APP_SECRET=
LONGPORT_PAPER_ACCESS_TOKEN=
LONGPORT_LIVE_ACCESS_TOKEN=

# Real-money switch. Leave empty until the paper checklist in USER_MANUAL.md is done.
DT_LIVE_ENABLED=

# Telegram alerts (make a NEW bot token: the old Iris token was exposed)
DT_TELEGRAM_BOT_TOKEN=
DT_TELEGRAM_CHAT_ID=

# Alpaca (free Basic plan, market data only, for the 5-year research data)
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_BASE_URL=https://paper-api.alpaca.markets
